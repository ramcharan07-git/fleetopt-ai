# FleetOpt AI Environment Configuration

# Backend Configuration
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
DEBUG=True
API_V1_STR=/api

# Security & JWT
SECRET_KEY=fleetopt-ai-super-secure-production-secret-key-change-in-prod-32bytes
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Local SQLite fallback or Supabase PostgreSQL
DATABASE_URL=sqlite:///./fleetopt.db
# DATABASE_URL=postgresql://postgres.xxx:password@aws-0-region.pooler.supabase.com:6543/postgres

# Supabase Public Keys (for mobile & client auth)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Firebase Push Notifications (Optional / mocked for dev)
FCM_SERVER_KEY=mock-fcm-server-key

# Optimization Defaults
DEFAULT_MAX_DUTY_HOURS=8.0
DEFAULT_MIN_REST_HOURS=11.0
DEFAULT_MAX_DRIVING_WITHOUT_BREAK=4.5
DEFAULT_BREAK_DURATION_MINUTES=45
SOLVER_TIME_LIMIT_SECONDS=30
