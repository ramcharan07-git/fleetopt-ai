# ==============================================================================
# FLEETOPT AI - BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
DEBUG=True
API_V1_STR=/api

# ------------------------------------------------------------------------------
# 1. AUTH & JWT SECURITY
# ------------------------------------------------------------------------------
SECRET_KEY=fleetopt-ai-super-secure-production-secret-key-32chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ------------------------------------------------------------------------------
# 2. DUAL DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# MySQL 8.x (Authoritative transactional relational database for fleet & schedules)
# Format: mysql+pymysql://<user>:<password>@<host>:<port>/<database>
MYSQL_DATABASE_URL=mysql+pymysql://fleetopt_user:your_mysql_password@localhost:3306/fleetopt_db

# Local SQLite fallback for instant offline development and automated testing
DATABASE_URL=sqlite:///./fleetopt.db

# MongoDB Atlas (High-frequency real-time GPS locations, telemetry & navigation history)
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://fleetopt_admin:your_mongo_password@cluster0.transit.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=fleetopt_telemetry

# ------------------------------------------------------------------------------
# 3. MAPPING & NAVIGATION APIS
# ------------------------------------------------------------------------------
# Google Maps Platform (Android Maps SDK, Geocoding, Distance Matrix)
GOOGLE_MAPS_API_KEY=AIzaSyYourGoogleMapsPlatformAPIKeyHere

# Routing Engine API (Google Routes API / OSRM compatible road navigation)
ROUTING_API_KEY=AIzaSyYourGoogleRoutesOrRoutingEngineKeyHere

# ------------------------------------------------------------------------------
# 4. EXTERNAL NOTIFICATIONS & WEATHER
# ------------------------------------------------------------------------------
# Firebase Cloud Messaging (FCM) service account JSON credentials path or server key
FIREBASE_CREDENTIALS_PATH=serviceAccountKey.json
FCM_SERVER_KEY=your_fcm_server_key_here

# OpenWeatherMap API for weather-augmented passenger demand forecasting
OPENWEATHER_API_KEY=your_openweather_api_key_here

# ------------------------------------------------------------------------------
# 5. GOOGLE OR-TOOLS OPTIMIZER DEFAULTS
# ------------------------------------------------------------------------------
DEFAULT_MAX_DUTY_HOURS=8.0
DEFAULT_MIN_REST_HOURS=11.0
DEFAULT_MAX_DRIVING_WITHOUT_BREAK=4.5
DEFAULT_BREAK_DURATION_MINUTES=45
SOLVER_TIME_LIMIT_SECONDS=30
